# Copy this to .env.local for local development
# Set these in Vercel project settings for production

# Your backend API URL (defaults to localhost:8081 if not set)
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# Set to "true" for a public marketing/demo deployment with no backend and
# no login required (fabricated data only). Leave unset for a real
# deployment against the actual backend -- login is required either way.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase project (see ../supabase/README.md) -- powers the org presence
# indicator only. Leave unset and the indicator just doesn't render.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
